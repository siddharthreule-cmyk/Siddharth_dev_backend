# Copy this file to .env for local development.
# On Render, set these under your service's "Environment" tab instead of committing a .env file.

# Port the server listens on. Render sets this automatically in production — you usually
# don't need to set it yourself on Render, this default is for running locally.
PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend's URL(s)).
# Example: https://your-swapify-site.netlify.app,http://localhost:5500
# Use "*" only while testing locally — do NOT use "*" in production.
CORS_ORIGIN=*

# Secret "admin code" — whoever signs up with this as their password becomes an admin.
# CHANGE THIS to your own long random value before deploying. Do not reuse 12367.
ADMIN_SECRET=change-this-to-a-long-random-value

# Required as a header (x-admin-secret) on the two admin-only routes:
# PUT /accounts/:username (rename) and DELETE /accounts/:username (remove user).
# It reuses ADMIN_SECRET above by default — see README for details.
